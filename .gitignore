# ============================================================================
# Secrets — NEVER commit. Use .env.example as the documented contract.
# ============================================================================
.env
.env.*
!.env.example
*.bak_*
ssl/*
!ssl/.gitkeep

# ============================================================================
# Customer data / PII — passport & Emirates ID scans, MOA, trade licences,
# and the extracted-field JSON that accompanies them. Must never enter history.
# ============================================================================
backend/documents/
backend/summary/
external_documents/

# OCR corpus fixtures are real customer documents — trade licences, tenancy
# contracts, passports. The recorded corpus (hashes, request shapes) is safe
# to keep; the source documents are not. See docs/ocr-corpus-runbook.md.
backend/tests/ocr_fixtures/**
!backend/tests/ocr_fixtures/**/.gitkeep
backend/tests/ocr_corpus/cassettes/

# ============================================================================
# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ============================================================================
# Node / React
# ============================================================================
node_modules/
frontend/build/
frontend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# ============================================================================
# Logs & runtime artifacts
# ============================================================================
logs/
*.log
test logs.txt

# ============================================================================
# Pre-refactor snapshots — safety copies, not source
# ============================================================================
_backup_*/
_snapshot_*/

# ============================================================================
# Editor / OS
# ============================================================================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Stage B0 behavioural capture output (temporary, see docs/HANDOFF.md)
logs/backend/capture/
backend/tests/golden/
