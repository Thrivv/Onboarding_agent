# ============================================================================
# Thrivv Onboarding Agent — environment contract
#
# Copy to .env.docker and fill in real values:
#     cp .env.example .env.docker
#
# .env.docker is git-ignored and must never be committed — it holds live
# credentials. This file documents every variable the application reads, so
# the required configuration is discoverable without grepping the source.
#
# Every key below is read through backend/app/config.py, which is the single
# source of truth. Defaults shown are the ones config.py applies when the
# variable is unset.
# ============================================================================

# ── REQUIRED — the application refuses to start without these ───────────────
# app/config.py raises ValueError at import if either is missing.
SUPABASE_URL=
SUPABASE_API_KEY=
# Optional: elevated key for service-role operations. Falls back to
# SUPABASE_API_KEY when unset.
SUPABASE_SERVICE_ROLE_KEY=

# ── IMPORTANT — startup logs a warning if unset, and the named feature ──────
#    silently does not work.
# Document extraction + all AI-generated messages:
OPENROUTER_API_KEY=
# Outbound email (verification, completion, OTP):
SMTP_SERVER=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
# Inbound email polling — used by the reply-loop container only:
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
# GrowX submission:
GROWX_BASE_URL=https://demo.growx.global

# ── Security ────────────────────────────────────────────────────────────────
# Salt for password hashing (app/services/auth_service.py uses hashlib).
# CHANGE THIS IN PRODUCTION — the built-in default is a placeholder.
PASSWORD_SECRET_KEY=mysecretkeyforhashing1234

# ── API surface ─────────────────────────────────────────────────────────────
API_BASE_PATH=/onboarding/ai/api
# Comma-separated. localhost:9000, 127.0.0.1:9000 and frontend:9000 are always
# allowed; set this to your real frontend URL(s) in production.
ALLOWED_ORIGINS=
# Base URL the backend advertises in outbound email links.
API_BASE_URL=http://localhost:7000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Log line format: plain (message only, default) | full (timestamp - logger -
# LEVEL - [request-id] - message). "full" is what you want when correlating a
# single request across many lines, or when you need to spot WARNING/ERROR.
LOG_STYLE=plain


# ── Mail transport ──────────────────────────────────────────────────────────
SMTP_PORT=587
IMAP_PORT=993

# ── LLM routing (OpenRouter) ────────────────────────────────────────────────
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Vision models — EID and Passport (image based)
LLM_VISION_PRIMARY=qwen/qwen2.5-vl-72b-instruct
LLM_VISION_FALLBACK=qwen/qwen-2.5-vl-7b-instruct
# Text models — Commercial, COI, MOA, Ejari, BVI, message generation
LLM_TEXT_PRIMARY=meta-llama/llama-3.3-70b-instruct
LLM_TEXT_FALLBACK=qwen/qwen-2.5-72b-instruct
LLM_CALL_TIMEOUT_SECONDS=45
MESSAGE_GEN_MAX_RETRIES=2

# ── Document extraction timeouts (seconds) ──────────────────────────────────
DOC_EXTRACTION_MAX_RETRIES=3
EJARI_API_TIMEOUT_SECONDS=60
MOA_API_TIMEOUT_SECONDS=60
TRADE_LICENSE_API_TIMEOUT_SECONDS=60
BVI_API_TIMEOUT_SECONDS=90
PASSPORT_API_TIMEOUT_SECONDS=60

# ── Storage paths ───────────────────────────────────────────────────────────
DOCUMENTS_PATH=/app/backend/documents/sme
# Optional secondary/mirror save location — no-op if unset or unwritable.
EXTERNAL_FILE_PATH=
USER_DOCS_BASE=/tmp/user_docs
FRONTEND_LOG_DIR=/var/log/frontend

# ── Cross-validation ────────────────────────────────────────────────────────
CROSS_VALIDATION_CORPORATE_SINGLE=true
CROSS_VALIDATION_CORPORATE_PARTNERSHIP=false
CROSS_VALIDATION_DEBUG_LOGGING=true
FUZZY_MATCH_THRESHOLD=0.85

# ── EID validation (SurePass) ───────────────────────────────────────────────
# Read dynamically by app/services/eid_validation.py — the key is selected at
# runtime from account_type + ownership_type, so these are not listed in
# config.py as static attributes.
EID_VALIDATION_CORPORATE_SINGLE=false
EID_VALIDATION_CORPORATE_PARTNERSHIP=false
SUREPASS_JWT_TOKEN=
SUREPASS_API_URL=

# ── Runtime ─────────────────────────────────────────────────────────────────
# Keep at 1. app/services/email_otp_service.py caches OTPs in a plain in-process
# dict, so a verify request routed to a second worker finds no OTP. See the
# comment block in supervisord.conf before raising this.
UVICORN_WORKERS=1
SESSION_TIMEOUT=3600
INACTIVITY_THRESHOLD_MINUTES=30
SESSION_TOKEN_EXPIRY_HOURS=24

# ── Stage B0 behavioural capture (TEMPORARY — remove after B5) ──────────────
# Records real inputs/outputs of the six functions being decomposed in Stage B5,
# so the refactor can be proven behaviour-identical rather than spot-checked.
# Leave UNSET in normal operation: when unset the decorator returns the original
# function untouched, so there is no wrapper and no overhead at all.
# Set to 1, restart, run one single-owner and one multi-owner onboarding, then
# unset and restart. Output lands in logs/backend/capture/ on the host.
# Email addresses are replaced with stable pseudonyms; file contents are never
# written, only their length.
# CAPTURE_BEHAVIOUR=1
# CAPTURE_DIR=/var/log/backend/capture

# ── Frontend build-time ─────────────────────────────────────────────────────
# Consumed by the Dockerfile as a build ARG, not by the Python backend.
REACT_APP_API_URL=/onboarding/ai/api

# ============================================================================
# NOT USED — present in .env.docker but read by no code.
#
#   JWT_SECRET_KEY   No JWT library is used. Authentication is session-based
#                    (app/services/session_service.py) and password hashing
#                    uses hashlib with PASSWORD_SECRET_KEY. python-jose was
#                    removed from requirements.txt in Stage A2 as unused.
#   OPENAI_API_KEY   Nothing imports the openai package; all LLM traffic goes
#                    to OpenRouter via OPENROUTER_API_KEY. Also removed from
#                    requirements.txt in Stage A2.
#
# Both are safe to delete from .env.docker. They are recorded here rather than
# silently dropped so the removal is a deliberate decision.
# ============================================================================
